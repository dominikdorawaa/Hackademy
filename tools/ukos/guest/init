#!/bin/sh
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mkdir -p /dev/pts /run /tmp
mount -t devpts devpts /dev/pts
mount -t tmpfs -o size=8m tmpfs /run
chmod 666 /dev/ttyS2
stty -F /dev/ttyS1 raw -echo 115200
stty -F /dev/ttyS2 raw -echo 115200
stty -F /dev/ttyS3 raw -echo 115200
/usr/local/bin/ukos-control < /dev/ttyS1 > /dev/ttyS1 2>/run/control-error &
while [ ! -f /run/ukos-start ]; do sleep 0.05; done
inotifywait -m -r -q -e close_write,create,delete,moved_to,moved_from,attrib --format DIRTY /home/student > /dev/ttyS3 2>/run/watch-error &
export TERM=xterm-256color
setsid -c su - student < /dev/ttyS0 > /dev/ttyS0 2>&1
printf 'FATAL\t0\tSesja terminala została zakończona. Uruchom warsztat ponownie.\n' > /dev/ttyS1
while true; do sleep 3600; done
