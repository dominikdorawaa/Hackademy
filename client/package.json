{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ukos:prepare": "node ../tools/ukos/build.mjs",
    "ukos:build": "npm run typecheck && vite build --config vite.ukos.config.ts",
    "ukos:preview": "vite preview --config vite.ukos.config.ts --host 0.0.0.0 --port 5175",
    "ukos:test:browser": "playwright test --config playwright.ukos.config.ts",
    "ukos:test": "vitest run src/prototypes/ukos --coverage --coverage.include='src/prototypes/ukos/*.{ts,tsx}' --coverage.exclude='src/prototypes/ukos/main.tsx' --coverage.reportsDirectory=coverage/ukos --coverage.thresholds.lines=80 --coverage.thresholds.perFile",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run src && node --test tests/*.test.mjs",
    "test:coverage": "vitest run src --coverage && node --test tests/*.test.mjs",
    "test:integration": "vitest run src/pages/LoginPage.test.tsx src/context/auth-routing.test.tsx",
    "test:realtime-load": "vitest run tests/realtime-load.test.tsx",
    "ukos:test:course": "playwright test --config playwright.course.config.ts"
  },
  "dependencies": {
    "@clerk/localizations": "^4.23.0",
    "@clerk/react": "^6.17.8",
    "@clerk/themes": "^2.4.57",
    "@phosphor-icons/react": "^2.1.10",
    "@stomp/stompjs": "^7.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dompurify": "3.4.16",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.8.0",
    "sockjs-client": "^1.6.1",
    "tw-animate-css": "^1.4.0",
    "v86": "0.5.471"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.47",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sockjs-client": "^1.5.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^5.0.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "6.2.6",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "tailwindcss": "^4.1.17",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.2.4",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
